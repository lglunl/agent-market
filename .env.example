# 服务端口（npm start 默认 3000）
PORT=3000

# 管理员默认账号（安装后可直接登录，无注册）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# JWT 签名密钥（生产请改成随机长字符串）
AUTH_SECRET=change-me-to-a-long-random-secret

# 会话 Cookie 是否仅走 HTTPS（true/false）。
# 直连 IP:端口、无 HTTPS 时设为 false，否则后台登录无法保持；配好 HTTPS 后改回 true。
# COOKIE_SECURE=false

# SQLite 与上传目录（相对项目根，可选）
# DATABASE_PATH=./data/agent-market.db
# UPLOAD_DIR=./uploads
